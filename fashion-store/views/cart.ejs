<%- include('partials/header') %>

<section class="section" style="padding-top:60px;">
  <div class="wrap">
    <span class="eyebrow">Your Selection</span>
    <h2>Bag</h2>

    <% if (items.length === 0) { %>
      <div class="empty-state">
        <h3>Your bag is empty.</h3>
        <p>Looks you add will appear here.</p>
        <a href="/shop" class="btn">Continue Shopping</a>
      </div>
    <% } else { %>
      <table class="cart-table">
        <thead>
          <tr>
            <th>Item</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function(item, i) { %>
            <tr class="cart-row">
              <td>
                <div class="cart-item">
                  <img src="<%= item.product.image %>" alt="<%= item.product.name %>" />
                  <div>
                    <div class="cart-item-name"><%= item.product.name %></div>
                    <div class="cart-item-opts"><%= item.product.lookNumber %> · Size <%= item.size %><% if (item.color) { %> · <%= item.color %><% } %></div>
                  </div>
                </div>
              </td>
              <td>$<%= item.product.price %></td>
              <td>
                <form action="/cart/update" method="post" class="qty-form">
                  <input type="hidden" name="index" value="<%= i %>" />
                  <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="10" class="qty-input" onchange="this.form.submit()" />
                </form>
              </td>
              <td>$<%= item.lineTotal %></td>
              <td>
                <form action="/cart/remove" method="post">
                  <input type="hidden" name="index" value="<%= i %>" />
                  <button type="submit" class="remove-link">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="cart-summary">
        <div class="summary-row">
          <span>Subtotal</span>
          <span>$<%= subtotal %></span>
        </div>
        <div class="summary-row" style="color:rgba(27,27,24,0.6); font-size:12px;">
          <span>Shipping calculated at checkout</span>
        </div>
        <div class="summary-row total">
          <span>Estimated Total</span>
          <span>$<%= subtotal %></span>
        </div>
        <a href="/checkout" class="btn btn-block btn-brass" style="margin-top:20px;">Proceed to Checkout</a>
        <a href="/shop" class="btn btn-outline btn-block" style="margin-top:12px;">Continue Shopping</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
